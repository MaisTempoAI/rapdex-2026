    {
      "parameters": {
        "jsCode": "let data = $json;\n\nlet chatPhone = data.body?.chat?.phone ?? \"\";\nlet chatId = data.body?.chat?.id ?? \"\";\nlet wid = data.body?.wid ?? \"\";\n\nlet hasPhone = chatPhone && chatPhone.trim() !== \"\";\n\n// Detecta lid a partir do chat.id original (campo separado OU id terminando em @lid)\nlet originalLid = data.body?.chat?.lid \n  ?? (chatId.includes(\"@lid\") ? chatId : null);\n\nif (!hasPhone) {\n  data.body.chat = {\n    id: chatId,\n    phone: null,\n    title: data.body.chat?.title ?? \"\",\n    lid: chatId\n  };\n\n  data.mobile = null;\n\n  if (wid) {\n    let cleanWid = wid.replace(/\\D/g, \"\");\n    cleanWid = cleanWid.replace(/^55/, \"\");\n    data.supabase = cleanWid;\n  } else {\n    data.supabase = null;\n  }\n\n  return { json: data };\n}\n\nlet cleanPhone = chatPhone.replace(/\\D/g, \"\");\n\nif (!cleanPhone.startsWith(\"55\")) {\n  cleanPhone = \"55\" + cleanPhone;\n}\n\nlet normalizedId = cleanPhone + \"@s.whatsapp.net\";\n\ndata.body.chat = {\n  id: normalizedId,\n  phone: cleanPhone,\n  title: data.body.chat?.title ?? \"\",\n  ...(originalLid ? { lid: originalLid } : {})  // sÃ³ inclui se tiver lid\n};\n\ndata.mobile = cleanPhone;\n\nif (wid) {\n  let cleanWid = wid.replace(/\\D/g, \"\");\n  cleanWid = cleanWid.replace(/^55/, \"\");\n  cleanWid = cleanWid.slice(0, 11);\n  data.supabase = cleanWid;\n} else {\n  data.supabase = null;\n}\n\nreturn { json: data };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -496,
        16
      ],
