      "typeVersion": 2,
      "position": [1440, 280],
      "id": "as006-0000-0000-0000-000000000006",
      "name": "SET TRIAL"
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "rapdex_slots",
        "filters": {
          "conditions": [
            {
              "keyName": "quepasa_key",
              "condition": "eq",
              "keyValue": "={{ $json.quepasakey }}"
            }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            {"fieldId": "login",            "fieldValue": "={{ $json.login }}"},
            {"fieldId": "n8n_hok_url",      "fieldValue": "={{ $json.n8n_hok_url }}"},
            {"fieldId": "status",           "fieldValue": "active"},
            {"fieldId": "trial_expires_at", "fieldValue": "={{ $json.trial_expires_at }}"}
          ]
        }
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1680, 280],
      "id": "as007-0000-0000-0000-000000000007",
      "name": "UPDATE SLOT",
      "credentials": {
        "supabaseApi": {
          "id": "DgrvFLRnv3scr06r",
          "name": "RAPDEX SUPABASE"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, quepasakey: $json.quepasa_key, login: $json.login, status: $json.status, trial_expires_at: $json.trial_expires_at }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
