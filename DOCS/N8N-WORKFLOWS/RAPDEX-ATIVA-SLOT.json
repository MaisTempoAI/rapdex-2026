    {
      "parameters": {
        "jsCode": "const input = $('SET INPUT').item.json;\nconst dias = Number(input.trial_dias) || 7;\nconst agora = new Date();\nconst expira = new Date(agora.getTime() + dias * 24 * 60 * 60 * 1000);\n\nreturn [{\n  json: {\n    quepasakey:       input.quepasakey,\n    login:            input.login,\n    n8n_hok_url:      input.n8n_hok_url,\n    trial_expires_at: expira.toISOString()\n  }\n}];"
      },
